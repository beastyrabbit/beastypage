{
  "name": "beastypage-media-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "lint": "biome check src test vitest.config.ts",
    "format": "biome check --write src test vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@hono/node-server": "^2.0.11",
    "file-type": "^22.0.1",
    "hono": "^4.12.31",
    "ipaddr.js": "^2.4.0",
    "sharp": "^0.35.3",
    "undici": "^8.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

    "file-type": "^22.0.2",
    "hono": "^4.13.5",
    "ipaddr.js": "^2.5.0",
    "sharp": "^0.35.4",
    "undici": "^8.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

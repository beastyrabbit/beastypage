{
  "name": "frontend",
  "version": "1.6.2",
  "private": true,
  "portless": "beastypage",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run next dev",
    "test": "vitest",
    "prebuild": "sh scripts/write-version.sh && tsx scripts/generate-registry.ts && tsx scripts/generate-cat-system.ts --frontend-only --check",
    "build": "next build",
    "start": "next start",
    "typecheck": "sh scripts/write-version.sh && tsc --noEmit",
    "lint": "biome lint . --max-diagnostics=20",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "cat-system:generate": "tsx scripts/generate-cat-system.ts && tsx scripts/generate-cat-system-probe.ts",
    "cat-system:check": "tsx scripts/generate-cat-system.ts --check && tsx scripts/generate-cat-system-probe.ts --check",
    "db:local": "tsx scripts/db/local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:drift": "sh scripts/db/check-drift.sh",
    "db:bundle": "esbuild scripts/db/migrate.ts --bundle --platform=node --format=esm --target=node24 --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=dist-db/scripts/db/migrate.mjs",
    "test:db": "vitest run --project database",
    "migration:inventory": "tsx scripts/migration/convex-inventory.ts",
    "import:convex": "tsx scripts/migration/import-convex.ts",
    "verify:import": "tsx scripts/migration/verify-import.ts",
    "smoke:cutover": "tsx scripts/migration/smoke.ts",
    "import:fixture": "tsx scripts/migration/import/fixture.ts",
    "scrub:staging": "tsx scripts/migration/scrub-staging.ts",
    "import:verify-quick-share": "tsx scripts/migration/verify-quick-share.ts",
    "convex:dev": "convex dev",
    "deploy": "pnpm exec convex deploy",
    "prepare": "pnpm exec convex codegen"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@clerk/ui": "^1.40.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "^1.0.8",
    "@scalar/nextjs-api-reference": "^0.11.17",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "binpackingjs": "^4.1.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.45.4",
    "family-chart": "^0.9.0",
    "fuse.js": "^7.5.0",
    "ipaddr.js": "^2.5.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "pixelmatch": "^7.2.0",
    "posthog-js": "^1.438.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "react-split-flap-effect": "^1.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "spin-wheel": "^5.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/d3-flextree": "^2.1.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "autoprefixer": "10.5.4",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.54",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.27.0",
    "glob": "^13.0.6",
    "jsdom": "^28.1.0",
    "portless": "^0.15.6",
    "postcss": "8.5.23",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}

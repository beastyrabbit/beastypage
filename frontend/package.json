{
  "name": "frontend",
  "version": "1.6.2",
  "private": true,
  "portless": "beastypage",
  "scripts": {
    "dev": "PORTLESS_PORT=1355 PORTLESS_HTTPS=0 portless run next dev",
    "test": "vitest",
    "prebuild": "sh scripts/write-version.sh && tsx scripts/generate-registry.ts && tsx scripts/generate-cat-system.ts --frontend-only --check",
    "build": "next build",
    "start": "next start",
    "typecheck": "sh scripts/write-version.sh && tsc --noEmit",
    "lint": "biome lint . --max-diagnostics=20",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "cat-system:generate": "tsx scripts/generate-cat-system.ts && tsx scripts/generate-cat-system-probe.ts",
    "cat-system:check": "tsx scripts/generate-cat-system.ts --check && tsx scripts/generate-cat-system-probe.ts --check",
    "convex:dev": "convex dev",
    "deploy": "pnpm exec convex deploy",
    "prepare": "pnpm exec convex codegen"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@clerk/ui": "^1.32.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "^1.0.8",
    "@scalar/nextjs-api-reference": "^0.11.17",
    "@tailwindcss/postcss": "4.3.3",
    "binpackingjs": "^4.1.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "d3-flextree": "^2.1.2",
    "d3-hierarchy": "^3.1.2",
    "family-chart": "^0.9.0",
    "fuse.js": "^7.5.0",
    "ipaddr.js": "^2.5.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.2",
    "pixelmatch": "^7.2.0",
    "posthog-js": "^1.427.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "react-split-flap-effect": "^1.0.0",
    "sonner": "^2.0.8",
    "spin-wheel": "^5.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/d3-flextree": "^2.1.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^25.9.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "10.5.4",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.54",
    "glob": "^13.0.6",
    "jsdom": "^28.1.0",
    "portless": "^0.15.6",
    "postcss": "8.5.23",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

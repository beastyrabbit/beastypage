{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "overrides": [
    {
      "includes": [
        "components/single-cat/ViewerClient.tsx",
        "lib/cat-system/__tests__/ear-accessory-probe.test.ts"
      ],
      "linter": {
        "rules": { "correctness": { "noUnsafeOptionalChaining": "warn" } }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "useButtonType": "warn",
        "useSemanticElements": "warn",
        "noSvgWithoutTitle": "warn",
        "noStaticElementInteractions": "warn",
        "noLabelWithoutControl": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noImplicitAnyLet": "warn",
        "noControlCharactersInRegex": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "complexity": {
        "noBannedTypes": "warn"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!out",
      "!build",
      "!convex/_generated",
      "!convex/*.d.ts",
      "!lib/single-cat",
      "!lib/streamer/steps.js",
      "!node_modules",
      "!**/*.css"
    ]
  }
}

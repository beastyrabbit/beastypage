# Global ignores
.DS_Store
*.log
*.tmp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pyc
**/__pycache__/

# Environment files
.env*
frontend/.env.local

# MCP config (contains API keys)
.mcp.json

# Claude Code local settings
.claude/


# Frontend build artifacts
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Backend virtual envs / caches
backend/renderer_service/.venv/
backend/renderer_service/.pytest_cache/
backend/renderer_service/renderer_service.egg-info/
backend/renderer_service/tests/__pycache__/
backend/renderer_service/*.png
# Lockfiles (uv.lock, pnpm-lock.yaml) are intentionally committed for reproducible builds

# Data exports / runtime assets
backend/catdex-export-20251022-142634/
backend/catdex-runtime/

# Legacy folders no longer tracked
backend/stream-canvas/
frontend-lagacy/
lifegen-fullgen/
node_modules/

# Systemd / secrets
systemd/

# Test scripts (may contain credentials)
test-*.sh

# Local reference checkouts and agent state
.codex
.codex/
.ref/
.pi/
frontend/.pi/

# Screenshots belong in .playwright-mcp/
/*.png

# Temporary/cache directories
.tmp/
.serena/

# Playwright MCP
.playwright-mcp/

# AI tool directories
.crush/
.goose/
.junie/

# Planning artifacts
plans/

# Convex generated files
convex/_generated/*
!convex/_generated/
!convex/_generated/ai/
!convex/_generated/ai/**

# Stale tsc output in frontend/convex (real codegen lives in _generated/)
frontend/convex/*.d.ts
frontend/convex/*.d.ts.map

# Skills lock
skills-lock.json

{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "frontend/public/apple-touch-icon.png",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Initialize worktree",
      "command": "./scripts/t3code-worktree-setup.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Frontend dev",
      "command": "pnpm dev:frontend",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Run locally",
      "command": "pnpm dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Typecheck",
      "command": "pnpm typecheck",
      "icon": "lint"
    }
  ]
}
